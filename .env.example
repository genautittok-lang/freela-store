# Copy to .env.local for development:
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43173
# ADMIN_PASSWORD=changeme-freela
# Production:
NEXT_PUBLIC_SITE_URL=https://freela.store
# On Vercel, omit DATABASE_PATH (defaults to /tmp/freela.db). Do not use a read-only path.
ADMIN_EMAIL=admin@freela.store
ADMIN_PASSWORD=replace-with-a-long-random-secret

