{
  "name": "freela-store",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 43173",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-43173}",
    "lint": "eslint",
    "test": "vitest run",
    "validate": "tsx scripts/validate-registry.ts",
    "qa": "tsx scripts/qa.ts && tsx scripts/audit-matrix.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "a11y": "playwright test e2e/launch.spec.ts -g accessibility",
    "release": "npm run typecheck && npm test && npm run validate && npm run qa && npm run lint && npm audit --audit-level=high && npm run e2e",
    "prebuild": "tsx scripts/validate-registry.ts && tsx scripts/qa.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@imgly/background-removal": "^1.7.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "heic2any": "^0.0.4",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "onnxruntime-web": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.9.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
