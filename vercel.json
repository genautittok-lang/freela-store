{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/tmp/freela-catalog-report-once.txt",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"freela-tools-catalog-report.txt\""
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
